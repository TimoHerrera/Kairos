# Kairos · variables de entorno
# Copiá este archivo como .env.local y completá lo que necesites.
# Con los valores por defecto (mock) la app funciona entera sin ninguna clave.
# Las que no empiezan con NEXT_PUBLIC_ viven solo en el servidor: nunca llegan al navegador.

# --- Datos -----------------------------------------------------------------
# mock: en memoria, guardado en localStorage del navegador. supabase: base real (fase 7).
# Es pública porque la fuente mock corre en el navegador.
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (solo si NEXT_PUBLIC_DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. No la expongas.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA --------------------------------------------------------------------
# mock: reglas locales que entienden las notas de la demo, sin claves.
# anthropic: API de Claude (se conecta en la fase 7).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Transcripción. Sin configurar (recomendado): usa el micrófono real en los navegadores
# que transcriben en vivo (Chrome, Edge) y deja la nota de ejemplo a un toque. Gratis.
# Para forzar un modo:
# - mock: siempre la nota de ejemplo, sin micrófono. Para presentar sin depender de la red.
# - webspeech: siempre el micrófono del navegador.
# - openai: graba y transcribe el servidor (necesita OPENAI_API_KEY, pago). Sin la clave, cae a webspeech.
TRANSCRIBE_PROVIDER=
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Avisos push ---------------------------------------------------------
# Opcionales. Sin claves, Kairos avisa con una notificación local mientras la app está abierta.
# Con claves, el aviso llega aunque la app esté cerrada. Generalas con: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Demo ------------------------------------------------------------------
# true muestra Perfil → Demo ("Simular propiedad nueva").
NEXT_PUBLIC_DEMO_MODE=true
