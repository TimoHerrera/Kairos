# Kairos · variables de entorno
# Copiá este archivo como .env.local y completá lo que necesites.
# Con los valores por defecto (mock) la app funciona entera sin ninguna clave.
# Las que no empiezan con NEXT_PUBLIC_ viven solo en el servidor: nunca llegan al navegador.

# --- Datos -----------------------------------------------------------------
# mock: en memoria, guardado en localStorage. supabase: base real (fase 7).
DATA_SOURCE=mock

# Supabase (solo si DATA_SOURCE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. No la expongas.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA --------------------------------------------------------------------
# mock: respuestas fijas del seed. anthropic: API de Claude.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Transcripción: openai | webspeech | mock
# webspeech usa la Web Speech API del navegador (es-AR), gratis para la demo.
TRANSCRIBE_PROVIDER=mock
OPENAI_API_KEY=

# --- Web Push (fase 6) -----------------------------------------------------
# Generalas con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Demo ------------------------------------------------------------------
# true muestra Perfil → Demo ("Simular propiedad nueva").
NEXT_PUBLIC_DEMO_MODE=true
